# The grader is any OpenAI-compatible endpoint. Copy to .env or export directly.

# --- Grader endpoint ---
# A local vLLM server (recommended for the A100 setup):
#   vllm serve Qwen/Qwen2.5-7B-Instruct --port 8001
GRADER_BASE_URL=http://localhost:8001/v1
GRADER_MODEL=Qwen/Qwen2.5-7B-Instruct
GRADER_API_KEY=EMPTY          # any non-empty string for keyless local servers

# Or point at a hosted API instead:
# GRADER_BASE_URL=https://api.openai.com/v1
# GRADER_MODEL=gpt-4o-mini
# GRADER_API_KEY=sk-...

# --- Grader behavior (optional) ---
GRADER_TEMPERATURE=0.0        # deterministic grading = lower-variance reward
GRADER_MAX_TOKENS=512
GRADER_MAX_CONCURRENCY=64     # in-flight grading requests per GRPO batch
