# The grader is any OpenAI-compatible endpoint. Copy to .env or export directly.

# --- Grader endpoint ---
# A local vLLM server (recommended for the A100 setup):
#   vllm serve Qwen/Qwen3-4B-Instruct-2507 --port 8001
GRADER_BASE_URL=http://localhost:8001/v1
GRADER_MODEL=Qwen/Qwen3-4B-Instruct-2507
GRADER_API_KEY=EMPTY          # any non-empty string for keyless local servers

# Or point at a hosted API instead:
# GRADER_BASE_URL=https://api.openai.com/v1
# GRADER_MODEL=gpt-4o-mini
# GRADER_API_KEY=sk-...

# --- Grader behavior (optional) ---
GRADER_TEMPERATURE=0.0        # deterministic grading = lower-variance reward
GRADER_MAX_TOKENS=1024        # room for a thinking model's reasoning + verdict;
                              # too low truncates the <think> block (unparsed score)
GRADER_MAX_CONCURRENCY=64     # in-flight grading requests per GRPO batch
                              # (drop to ~8-16 for hosted OpenAI to avoid 429s)

# --- Robustness (matters most against a paid/rate-limited API) ---
GRADER_MAX_RETRIES=6          # SDK retries w/ backoff on 429/5xx/timeout
GRADER_TIMEOUT=60             # per-request seconds (blank = SDK default)
GRADER_ON_ERROR=raise         # raise = abort on persistent failure (recommended);
                              # zero = score 0.0 and keep going (can corrupt reward)
GRADER_REASONING=false        # true for o-series/reasoning models
                              # (sends max_completion_tokens, drops temperature)
GRADER_ENABLE_THINKING=       # blank=server default; false disables <think> for
                              # open thinking models (Qwen3) via vLLM — recommended
                              # for grading (short, fast, unambiguous verdict)
